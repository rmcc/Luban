// ==========================================================================
// Base styles: opinionated defaults
// ==========================================================================
@import './global-var.styl';

/* automatic color inversion for dark mode */
@media (prefers-color-scheme: dark) {
  // Invert everything
  html {
    filter: invert(1) url(#lossless-hue-rotate);
  }

  // Un-invert these
  img, video, iframe, canvas, .dont-invert, image#image-background {
    filter: url(#lossless-hue-rotate) invert(1);
  }

  // These are exceptions to the above - we do want them inverted by the
  // main html{} filter
  div[class*="link-bar-item"] img { // The function icons in the home menu
    filter: none
  }
}

body {
    margin: 0;
    font-size: 13px;
    color: #222222;
    text-align: left;
    background-color: #ffffff;
    min-width: 960px;

    @media (max-width: 767px) {
        min-width: 0;
    }
    a {
        color: $black-3;
        &:hover {
            color: $black-4;
        }
    }
}

/*
 * Remove text-shadow in selection highlight: h5bp.com/i
 * These selection rule sets have to be separate.
 * Customize the background color to match your design.
 */

::-moz-selection {
    background: #b3d4fc;
    text-shadow: none;
}

::selection {
    background: #b3d4fc;
    text-shadow: none;
}

/*
 * Remove the gap between images, videos, audio and canvas and the bottom of
 * their widget: h5bp.com/i/440
 */

audio,
canvas,
img,
svg,
video {
    vertical-align: middle;
}

/*
 * Remove default fieldset styles.
 */

fieldset {
    border: 0;
    margin: 0;
    padding: 0;
}

/*
 * Allow only vertical resizing of textareas.
 */

textarea {
    resize: vertical;
}
