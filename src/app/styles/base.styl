// ==========================================================================
// Base styles: opinionated defaults
// ==========================================================================
@import './global-var.styl';

/* automatic color inversion for dark mode */
@media (prefers-color-scheme: dark) {
  // Invert everything
  html {
    filter: invert(1) url(#lossless-hue-rotate);
  }

  // Un-invert these
  img, video, iframe, canvas, .dont-invert, image#image-background {
    filter: url(#lossless-hue-rotate) invert(1);
  }

  // These are exceptions to the above - we do want them inverted by the
  // main html{} filter
  div[class*="link-bar-item"] img { // The function icons in the home menu
    filter: none
  }
}

/* Force old hardwired values into the new antd "hovering stuff" constraints. */
:global(.ant-tooltip)
    position: absolute !important
    will-change: transform, opacity !important
    max-width: 270px !important // Pinches the floating column width back to normal bounds which were hardwired in old antd and assumed by Luban in large tooltips
    pointer-events: auto !important

:global(.ant-slider-vertical .ant-slider-handle:not(:hover):not(:active) ~ div .ant-tooltip),
:global(.ant-slider-vertical .ant-slider-handle:not(:hover):not(:active) + .ant-tooltip)
    opacity: 0 !important
    visibility: hidden !important
    pointer-events: none !important

:global(.ant-tooltip-inner)
    white-space: normal !important
    word-break: break-word !important
    word-wrap: break-word !important

:global(.ant-popover)
    position: fixed !important // Rips it out of your row overflow:hidden boundaries
    will-change: transform, opacity !important
    transform: translateZ(0) !important
    pointer-events: auto !important // Ensures links/buttons inside popovers stay clickable
    min-width: 220px !important // FORCES the 0px collapsed horizontal frame window open
    max-width: 320px !important
    z-index: 999999 !important

:global(.ant-popover-inner)
    background-color: #ffffff !important // Solid white card layer canvas
    box-shadow: 0 6px 16px 0 rgba(0, 0, 0, 0.25) !important
    border-radius: 8px !important

:global(.ant-popover-inner-content)
    white-space: normal !important
    word-break: break-word !important
    word-wrap: break-word !important
    padding: 12px 16px !important // Restores padding margins around descriptions
    color: #1f1f1f !important // Explicit dark text color visibility

body {
    margin: 0;
    font-size: 13px;
    color: #222222;
    text-align: left;
    background-color: #ffffff;
    min-width: 960px;

    @media (max-width: 767px) {
        min-width: 0;
    }
    a {
        color: $black-3;
        &:hover {
            color: $black-4;
        }
    }
}

/*
 * Remove text-shadow in selection highlight: h5bp.com/i
 * These selection rule sets have to be separate.
 * Customize the background color to match your design.
 */

::-moz-selection {
    background: #b3d4fc;
    text-shadow: none;
}

::selection {
    background: #b3d4fc;
    text-shadow: none;
}

/*
 * Remove the gap between images, videos, audio and canvas and the bottom of
 * their widget: h5bp.com/i/440
 */

audio,
canvas,
img,
svg,
video {
    vertical-align: middle;
}

/*
 * Remove default fieldset styles.
 */

fieldset {
    border: 0;
    margin: 0;
    padding: 0;
}

/*
 * Allow only vertical resizing of textareas.
 */

textarea {
    resize: vertical;
}
